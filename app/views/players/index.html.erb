<h1>Players</h1>

<p><%= link_to "Add New Player", new_player_path %></p>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @players.each do |player| %>
      <tr>
        <td><%= player.name %></td>
        <td><%= link_to "Remove", player_path(player), data: { turbo_method: :delete, turbo_confirm: "Remove #{player.name}?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
