<h1>Leaderboard</h1>

<table>
  <thead>
    <tr>
      <th>Rank</th>
      <th>Player</th>
      <th>Wins</th>
      <th>Losses</th>
      <th>Matches Played</th>
    </tr>
  </thead>
  <tbody>
    <% @players.each.with_index(1) do |player, rank| %>
      <tr>
        <td><%= rank %></td>
        <td><%= player.name %></td>
        <td><%= player.wins %></td>
        <td><%= player.losses %></td>
        <td><%= player.wins + player.losses %></td>
      </tr>
    <% end %>
  </tbody>
</table>
